{
  "name": "crimson-gull",
  "private": true,
  "version": "0.1.0",
  "description": "Crimson Gull — a browser-based 3D co-op escape room for 4 to 15 players",
  "workspaces": [
    "packages/engine",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @crimson/server",
    "dev:client": "npm run dev -w @crimson/client",
    "build": "npm run build -w @crimson/client",
    "start": "npm run start -w @crimson/server",
    "test": "npm test -w @crimson/engine && npm test -w @crimson/server",
    "typecheck": "tsc -p packages/engine && tsc -p packages/server && tsc -p packages/client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
